# Keep the service on localhost when using Nginx/Caddy on the same server.
BIND_ADDRESS=127.0.0.1
APP_PORT=3100
# Prebuilt by GitHub Actions; the cloud host does not need Docker Hub or npm.
CRM_IMAGE=ghcr.io/hydintern3/crm-settlement:latest
# 管理员账号。不要提交真实 .env。
CRM_ADMIN_USERNAME=admin
# 在可信开发机通过标准输入运行 `npm run admin:hash -- --stdin` 生成，避免密码进入仓库。
CRM_ADMIN_PASSWORD_HASH='scrypt$请替换'
# 至少32字节随机值，可用 `openssl rand -base64 48` 生成；轮换后现有会话全部失效。
CRM_SESSION_SECRET=请替换为随机密钥
