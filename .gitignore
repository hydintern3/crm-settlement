# CRM source data and locally generated analysis artifacts
/csv_output/
/outputs/
/.codex/
/*.xls
/*.xlsx
/*.xlsm
/*.xlsb
/*.ods
/*.csv
/*.tsv
~$*

# Allow deliberately sanitized test fixtures when they are added later
!platform/tests/fixtures/**/*.csv
!platform/tests/fixtures/**/*.tsv

# Local snapshots must never be committed or published
**/public/data/local-snapshot.json

# Dependencies and build outputs
**/node_modules/
**/.next/
**/.vinext/
**/dist/
**/out/
**/coverage/
**/.wrangler/
**/.turbo/
**/.cache/
**/*.tsbuildinfo

# Local environments, secrets, and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.pfx
**/*.p12

# Logs, temporary files, and packaged site artifacts
**/*.log
**/*.tmp
**/*.temp
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip

# Audited SheetJS release is vendored for reproducible offline deployment
!platform/vendor/xlsx-0.20.3.tgz

# Python and tool caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
